        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Mapping": {
        "properties": {
          "monthly_id": {
            "type": "string",
            "pattern": "^plan_[A-Za-z0-9]+$",
            "title": "Monthly Id"
          },
          "yearly_id": {
            "type": "string",
            "pattern": "^plan_[A-Za-z0-9]+$",
            "title": "Yearly Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "monthly_id",
          "yearly_id"
        ],
        "title": "Mapping"
      },
      "MemberInput": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "pattern": "^(manager|cashier)$",
            "title": "Role"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "role"
        ],
        "title": "MemberInput"
      },
      "Named": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Named"
      },
      "PlanInput": {
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,39}$",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "monthly_amount": {
            "type": "integer",
            "maximum": 100000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Monthly Amount"
          },
          "yearly_amount": {
            "type": "integer",
            "maximum": 1000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Yearly Amount"
          },
          "branch_limit": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 1.0,
            "title": "Branch Limit"
          },
          "user_limit": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 1.0,
            "title": "User Limit"
          },
          "warehouses": {
            "type": "boolean",
            "title": "Warehouses",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "name",
          "monthly_amount",
          "yearly_amount",
          "branch_limit",
          "user_limit"
        ],
        "title": "PlanInput"
      },
      "Recovery": {
        "properties": {
          "provider_ref": {
            "type": "string",
            "pattern": "^sub_[A-Za-z0-9]+$",
            "title": "Provider Ref"
          }
        },
        "type": "object",
        "required": [
          "provider_ref"
        ],
        "title": "Recovery"
      },
      "Selection": {
        "properties": {
          "plan": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Plan"
          },
          "cycle": {
            "type": "string",
            "enum": [
              "monthly",
              "yearly"
            ],
            "title": "Cycle"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "plan",
          "cycle"
        ],
        "title": "Selection"
      },
      "Status": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Status"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WarehouseInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
