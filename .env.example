# Generate independent hex values with: python -c "import secrets; print(secrets.token_hex(32))"
# Hex passwords are URL-safe. Never commit .env.
DB_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=
# Development on localhost HTTP only; use true and HTTPS outside local development.
SECURE_COOKIES=false
WEB_ORIGIN=http://localhost:8080

# Sandbox collects no money and must not be enabled in production.
ENVIRONMENT=development
BILLING_PROVIDER=sandbox
TRIAL_DAYS=14
GRACE_DAYS=3
SANDBOX_WEBHOOK_SECRET=
# Set these in your private .env when selecting razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PREVIOUS_WEBHOOK_SECRET=
